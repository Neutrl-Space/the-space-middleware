SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

GMAIL_USER=
GMAIL_APP_PASSWORD=

ADMIN_SECRET=
MIDDLEWARE_URL=

SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=write_customers,write_metaobject_definitions,write_metaobjects,write_products,read_products,read_inventory,read_orders,write_orders,read_discounts,write_discounts
SHOPIFY_API_VERSION=2026-01
SHOPIFY_METAOBJECT_TYPE=invite_request

POPUP_ALLOWED_ORIGINS=

BECOMING_ACCESS_COLLECTION_HANDLE=becoming
BECOMING_ACCESS_CUSTOMER_TAGS=becoming-access,soho-popup-2026,restock-interest
BECOMING_ACCESS_CAMPAIGN=sep24_popup_2026

# Enable only after migration, baseline, webhooks, scheduler and Shopify email automation are verified.
NEWSLETTER_ENABLED=false
# Allows authenticated events to queue while discount processing and email handoff remain off.
NEWSLETTER_WEBHOOKS_ENABLED=false
NEWSLETTER_CAMPAIGN=welcome-v1
NEWSLETTER_DISCOUNT_DAYS=1
NEWSLETTER_DISCOUNT_USAGE_LIMIT=1
# At least 32 random characters. Supports trusted Bearer calls or the Supabase scheduler's short-lived HMAC signatures.
CRON_SECRET=

# Separate random secret, at least 32 characters. Used by external monitoring GET /api/health.
# Keep this server-side and in the monitor's Authorization header; never in a URL or theme asset.
MONITORING_SECRET=

# Enable after applying newsletter-instant-offers.sql and configuring storefront origins.
NEWSLETTER_INSTANT_ENABLED=false
# Enable after configuring the separate Shopify reminder automation.
NEWSLETTER_REMINDERS_ENABLED=false
