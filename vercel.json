{
  "version": 2,
  "routes": [
    {
      "src": "/api/newsletter/offer/?",
      "dest": "/api/newsletter/process?__newsletterAction=offer"
    },
    {
      "src": "/api/projects/?",
      "dest": "/api/projects/dispatch?__projectAction=index"
    },
    {
      "src": "/api/projects/(approve|reject|status-changed|email-preview|index)/?",
      "dest": "/api/projects/dispatch?__projectAction=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "functions": {
    "api/newsletter/process.js": {
      "maxDuration": 60
    },
    "api/becoming-access.js": {
      "maxDuration": 60
    },
    "api/becoming-optin.js": {
      "maxDuration": 60
    }
  }
}
